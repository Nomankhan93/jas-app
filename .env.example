# JAS App environment variables
# Copy this file to .env.local and fill in your own project values.
# Never commit or share .env, .env.local, or any file containing real secrets.

# Client-safe Supabase values. These are allowed to use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Supabase values. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional site URL used for QR verification links / deployment docs.
# Use your Vercel/custom domain in production.
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# Web Push Notifications
# Browser/client receives only the public key.
VITE_VAPID_PUBLIC_KEY=

# Edge Function / server-only secrets. Set these in Supabase secrets, not client env.
# npx supabase secrets set VAPID_PUBLIC_KEY="..."
# npx supabase secrets set VAPID_PRIVATE_KEY="..."
# npx supabase secrets set VAPID_SUBJECT="mailto:admin@example.com"
# npx supabase secrets set PUSH_SEND_SECRET="$(openssl rand -hex 32)"
# npx supabase secrets set PUSH_MAX_SENDS_PER_MINUTE="120"

# Branded transactional notification emails (server/Edge Function only)
# Set these with `npx supabase secrets set ...`; never use a VITE_ prefix.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=support@jasofficial.org
BREVO_SENDER_NAME=Jatt Alliance Sindh
EMAIL_WORKER_SECRET=generate_a_random_64_character_secret
PUBLIC_SITE_URL=https://jasofficial.org
# Optional: true validates Brevo requests without delivering email.
BREVO_SANDBOX_MODE=true
